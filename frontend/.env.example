# Copy to frontend/.env for local dev, or set as Environment Variables on
# the Render Static Site (Vite bakes these in at BUILD time, not runtime —
# so you must redeploy/rebuild after changing them).

# The backend web service's public URL.
VITE_API_URL=https://your-backend.onrender.com

# The backend's WebSocket URL — same host, ws(s):// instead of http(s)://.
VITE_WS_URL=wss://your-backend.onrender.com
