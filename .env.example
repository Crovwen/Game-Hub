# Copy this file to backend/.env for local development.
# On Render, set every one of these in the service's Environment tab instead
# of committing a .env file — see README.md "Render Deployment".

# --- Telegram ---------------------------------------------------------------
# Token from @BotFather. Required. Never commit this. Never log it.
BOT_TOKEN=123456789:AAExampleExampleExampleExampleExample

# --- Database ----------------------------------------------------------------
# Standard Postgres connection string. Works with Render Postgres, Neon,
# Supabase, or local Postgres. See README for why Render's *free* Postgres
# (30-day expiry) may not be the right long-term choice for this variable.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Auth ----------------------------------------------------------------
# Long random string used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# --- Public URLs ---------------------------------------------------------------
# WEBAPP_URL = the public URL of the FRONTEND (Render Static Site), e.g.
# https://your-frontend.onrender.com — this is what the bot's "Open" button
# launches, and what the backend's CORS check allows requests from.
WEBAPP_URL=https://your-frontend.onrender.com

# BACKEND_URL = the public URL of THIS backend service, used only to
# register the Telegram webhook at <BACKEND_URL>/bot/webhook. On Render you
# can usually leave this blank — Render sets RENDER_EXTERNAL_URL
# automatically and the backend falls back to it (see src/config/env.js).
BACKEND_URL=

# --- Optional --------------------------------------------------------------
# Only needed once you scale beyond a single instance (see
# backend/src/realtime/sessionManager.js for why it's not required today).
REDIS_URL=

# How many coins a brand-new user starts with.
INITIAL_COINS=1000

# development | production
NODE_ENV=development
PORT=3000
